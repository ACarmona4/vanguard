{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VanguardInventoryReadOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeRegions",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "iam:ListRoles",
        "iam:ListUsers",
        "sns:ListTopics",
        "sqs:ListQueues",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}

