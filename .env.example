DATABASE_URL=postgresql:///vanguard
VANGUARD_ENVIRONMENT=development
VANGUARD_SECURE_COOKIES=false
VANGUARD_AUTO_COLLECT=true
VANGUARD_COLLECTION_INTERVAL_SECONDS=60
VANGUARD_METRICS_ENABLED=true
VANGUARD_METRICS_INTERVAL_SECONDS=60
VANGUARD_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
VANGUARD_PROMETHEUS_URL=http://127.0.0.1:9090
